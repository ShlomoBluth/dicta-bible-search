{
  "name": "dicta-search",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:tool": "cypress run --spec cypress/e2e/toolTests.js",
    "test:requests": "cypress run --spec cypress/e2e/requestsTests.js",
    "test:dev-requests": "cypress run --spec cypress/e2e/DevelopmentVersionRequestsTests.js",
    "open": "cypress open",
    "report": "mochawesome-merge \"cypress/results/json/*.json\" > index.json && marge index.json --reportDir public",
    "searchResults-convert": "mammoth cypress/downloads/searchResults.docx cypress/downloads/searchResults.html"
  },
  "engines": {
    "node": "^20.1.0 || ^22.0.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShlomoBluth/dicta-search.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ShlomoBluth/dicta-search/issues"
  },
  "homepage": "https://github.com/ShlomoBluth/dicta-search#readme",
  "devDependencies": {
    "cypress": "^15.21.1",
    "cypress-multi-reporters": "^1.4.0",
    "mocha": "^8.3.2",
    "mochawesome": "^7.0.1",
    "mochawesome-merge": "^4.2.0"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001278",
    "js-levenshtein": "^1.1.6",
    "mammoth": "^1.4.16"
  }
